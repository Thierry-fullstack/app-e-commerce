{% extends 'base.html.twig' %}

    {% block title %}Liste Catégories{% endblock %}

    {% block body %}
        <section>
            <div class="container">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="{{ path('app_admin_index') }}"><span class="badge bg-primary">Administration</span></a></li>
                        <li class="breadcrumb-item"><a>Catégories</a></li>
                        <li class="breadcrumb-item"><a>Liste</a></li>
                    </ol>
                </nav>
                <div class="row">
                    <div class="col-md-10 mx-auto">
                        {% if categories is defined and categories is not empty %}
                            <fieldset><legend class="d-flex justify-content-center text-primary h3">Liste des catégories</legend></fieldset>
                            <table class="table table-hover table-bordered" id="catégories_list">
                                <thead>
                                <tr class="table-light">
                                    <th class="text-primary" scope="col">Photo</th>
                                    <th class="text-primary d-none d-sm-table-cell" scope="col">N°</th>
                                    <th class="text-primary" scope="col">Nom</th>
                                    <th class="text-primary" scope="col">Type</th>
                                    <th class="text-primary" scope="col">Action</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for category in categories %}
                                    {% include '_components/_list_categories.html.twig' %}
                                {% endfor %}
                            </table>
                            <hr class="my-3 text-primary" />
                            <!-- Pagination-->
                            <nav aria-label="Pagination" class="d-flex justify-content-center">
                                {{ knp_pagination_render(categories) }}
                            </nav>
                        {% else %}
                            <div class="mt-5">
                                <h3 class="text-primary fw-bolder d-flex justify-content-center">La table : Catégorie est vide !</h3>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </section>
    {% endblock %}

