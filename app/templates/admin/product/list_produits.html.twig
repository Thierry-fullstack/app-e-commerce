{% extends 'base.html.twig' %}

{% block title %}Gestion - Articles{% endblock %}

{% block body %}
    <div class="container py-5">
        <h3 class="mb-5 text-center text-primary">Gestion des articles</h3>
        <div class="row">
            <hr class="my-3 border-3 text-primary" />
        <div class="col-12">
            <table class="table table-sm table-bordered px-1 py-1">
                <thead>
                <tr class="table-warning">
                    <th width="25%" class="d-none d-md-table-cell" scope="col">Photo</th>
                    <th scope="col">N°</th>
                    <th  width="20%" scope="col">Nom</th>
                    <th scope="col">Prix</th>
                    <th scope="col">Stock</th>
                    <th width="15%" class="d-none d-md-table-cell">Catégorie</th>
                    <th scope="col">Action</th>
                </tr>
                </thead>
                <tbody>
                {% for produit in produits %}
                <tr>
                    <th class="d-none d-md-table-cell" scope="row"><img src="{{ asset('assets/uploads/product/') ~ produit.images[0].name }}" alt="{{ produit.slug }}" class="img-fluid pe-4 h-25 w-25" ></th>
                    <td>{{ produit.id }}</td>
                    <td>{{ produit.name }}</td>
                    <td>{{ produit.price }}</td>
                    <td>{{ produit.stock }}</td>
                    <td class="d-none d-md-table-cell">{{ produit.categorie.name }}</td>
                    <td><a href="#" class="btn btn-sm btn-outline-secondary">Modifier</a></td>
                </tr>
                {% endfor %}
                </tbody>
            </table>
            <hr class="my-3 border-3 text-primary" />
            <!-- Pagination-->
            <nav aria-label="Pagination" class="d-flex justify-content-center my-3">
                {{ knp_pagination_render(produits) }}
            </nav>

        </div>

        </div>
    </div>
{% endblock %}
