{% extends 'base.html.twig' %}

{% block title %}Ajout - Article{% endblock %}

{% block body %}
    {% if exception is defined %}
    {{ exception }}
    {%  endif %}
    <div class="container mt-1">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('app_admin_index') }}"><span class="badge bg-primary">Administration</span></a></li>
                <li class="breadcrumb-item"><a>Produit</a></li>
                <li class="breadcrumb-item"><a>Nouveau</a></li>
            </ol>
        </nav>
        <div class="section-title">
            <h3 class="text-primary fw-semibold">Nouvel article</h3>
        </div>
        <div class="row">
            <section class="col-md-10 col-sm-12 mx-auto">
                {{ form_start(form,{attr:{id:'form_add_product',novalidate:'novalidate'}}) }}
                <div class="form-floating mb-3">
                    {{ form_widget(form.name) }}
                    {{ form_label(form.name) }}
                    <div class="text-danger small">
                        {{ form_errors(form.name) }}
                    </div>
                </div>
                <div class="form-floating mb-3">
                    {{ form_widget(form.description) }}
                    {{ form_label(form.description) }}
                    <div class="text-danger small">
                        {{ form_errors(form.description) }}
                    </div>
                </div>
                <div class="row mb-4">
                        <div class="col-6 form-floating">
                            {{ form_widget(form.price) }}
                            {{ form_label(form.price) }}
                            <div class="text-danger small">
                                {{ form_errors(form.price) }}
                            </div>
                        </div>
                        <div class="col-6 form-floating">
                            {{ form_widget(form.stock) }}
                            {{ form_label(form.stock) }}
                            <div class="text-danger small">
                                {{ form_errors(form.stock) }}
                            </div>
                        </div>
                </div>
                <div class="form-floating mb-3">
                    {{ form_widget(form.category) }}
                    {{ form_label(form.category) }}
                    <div class="text-danger small">
                        {{ form_errors(form.category) }}
                    </div>
                </div>
                <div class="form-floating mb-3">
                    {{ form_widget(form.images) }}
                    {{ form_label(form.images) }}
                    <div class="text-danger small">
                        {{ form_errors(form.images) }}
                    </div>
                </div>
                {{ form_end(form) }}
            </section>
        </div>
    </div>

{% endblock %}
