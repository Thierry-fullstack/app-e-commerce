{% extends 'base.html.twig' %}

{% block title %}Nouveau type{% endblock %}
{% block importmap %}
    {{ importmap(['app','ajax-type']) }}
{% endblock %}
{% block body %}
    <section>
        <div class="container">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('app_admin_index') }}"><span class="badge bg-primary">Administration</span></a></li>
                    <li class="breadcrumb-item"><a>Types</a></li>
                    <li class="breadcrumb-item"><a>Nouveau</a></li>
                </ol>
            </nav>
            <div class="section-title">
                <h3 class="text-primary-emphasis">Nouveau type</h3>
                <p class="text-primary">Indication : <span class="text-capitalize text-warning-emphasis">Télécharger la photographie</span></p>
            </div>
            <div class="row">
                <div class="col-md-10 mx-auto">
                    {{ form_start(form,{attr:{id:'newTypeForm',novalidate:'novalidate'}}) }}
                    <div class="form-floating mb-3">
                        {{ form_widget(form.name) }}
                        {{ form_label(form.name) }}
                        <div class="text-danger small">
                            {{ form_errors(form.name) }}
                        </div>
                    </div>
                    <div class="form-check form-switch">
                        {{ form_widget(form.isParent) }}
                        {{ form_label(form.isParent,{attr:{class:'form-check-label'}}) }}
                        <div class="text-danger small">
                            {{ form_errors(form.isParent) }}
                        </div>
                    </div>
                    <div class="d-flex justify-content-end">
                        {{ form_row(form.submit) }}
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
        <div class="container mt-3">
            <div class="row">
                <div class="col-md-10 mx-auto">
                    {% if types is not empty %}
                        <fieldset class="text-primary-emphasis" ><legend class="text-capitalize d-flex justify-content-center">Liste des types</legend></fieldset>
                        <table class="table table-hover table-bordered" id="types_list">
                            <thead>
                            <tr class="table-light">
                                <th class="text-primary" scope="col">Photo</th>
                                <th class="text-primary d-none d-sm-table-cell" scope="col">N°</th>
                                <th class="text-primary" scope="col">Nom</th>
                                <th class="d-none d-sm-table-cell" text-primary" scope="col">Principal</th>
                                <th class="text-primary" scope="col">Action</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for type in types  %}
                                {% include '_components/_list_types.html.twig' with { types : types }  %}
                            {% endfor %}
                            </tbody>
                        </table>
                        <!-- Pagination-->
                        <nav aria-label="Pagination" class="d-flex justify-content-center">
                            {{ knp_pagination_render(types) }}
                        </nav>
                        <hr class="my-3 text-primary" />
                    {% endif %}
                </div>
            </div>
        </div>
    </section>
{% endblock %}

