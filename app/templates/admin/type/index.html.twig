{% extends 'base.html.twig' %}

    {% block title %}Liste type-produit{% endblock %}

    {% block body %}
        <section>
            <div class="container">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="{{ path('app_admin_index') }}"><span class="badge bg-primary">Administration</span></a></li>
                        <li class="breadcrumb-item"><a>Types</a></li>
                        <li class="breadcrumb-item"><a>Liste</a></li>
                    </ol>
                </nav>
                <div class="row">
                    <div class="col-md-10 mx-auto">
                        {% if types is defined and types is not empty %}
                            <fieldset><legend class="d-flex justify-content-center text-primary h3">Liste des types</legend></fieldset>
                            <table class="table table-hover table-bordered" id="types_list">
                                <thead>
                                <tr class="table-light">
                                    <th class="text-primary" scope="col">Photo</th>
                                    <th class="text-primary d-none d-sm-table-cell" scope="col">N°</th>
                                    <th class="text-primary" scope="col">Nom</th>
                                    <th class="text-primary" scope="col">Action</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for type in types %}
                                    {% include '_components/_list_types.html.twig' %}
                                {% endfor %}
                            </table>
                            <hr class="my-3 text-primary" />
                            <!-- Pagination-->
                            <nav aria-label="Pagination" class="d-flex justify-content-center">
                                {{ knp_pagination_render(types) }}
                            </nav>
                            {% else %}
                                <div class="mt-5">
                            <h3 class="text-primary fw-bolder d-flex justify-content-center">La table : Type de produits est vide !</h3>
                                </div>
                                    {% endif %}
                    </div>
                </div>
            </div>
        </section>
    {% endblock %}

