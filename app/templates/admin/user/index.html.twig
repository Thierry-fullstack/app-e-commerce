{% extends 'base.html.twig' %}

{% block title %}Liste inscrits{% endblock %}

{% block body %}
    <section>
        <div class="container">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('app_admin_index') }}"><span class="badge bg-primary">Administration</span></a></li>
                    <li class="breadcrumb-item"><a>inscrits</a></li>
                    <li class="breadcrumb-item"><a>Liste</a></li>
                </ol>
            </nav>
            <div class="row">
                <div class="col-md-12 mx-auto">
                    {% if users is defined and users is not empty %}
                        <fieldset class="text-primary-emphasis" ><legend class="d-flex justify-content-center h3">Liste des inscrits</legend></fieldset>
                        <table class="table table-hover table-bordered" id="marks_list">
                            <thead>
                            <tr class="table-light">
                                <th class="text-primary" scope="col">N°</th>
                                <th class="text-primary" d-none d-sm-table-cell" scope="col">Email</th>
                                <th class="text-primary" scope="col">Role</th>
                                <th class="text-primary" scope="col">Date</th>
                                <th class="text-primary" scope="col">Prénom</th>
                                <th class="text-primary" scope="col">Nom</th>
                                <th class="text-primary" scope="col">Action</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for user in users %}
                                {% include '_components/_list_users.html.twig' %}
                            {% endfor %}
                        </table>
                        <hr class="my-3 text-primary" />
                        <!-- Pagination-->
                        <nav aria-label="Pagination" class="d-flex justify-content-center">
                            {{ knp_pagination_render(users) }}
                        </nav>
                    {% else %}
                        <div class="mt-5">
                            <h3 class="text-primary fw-bolder d-flex justify-content-center">La table des Incrits est vide !</h3>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </section>

{% endblock %}
