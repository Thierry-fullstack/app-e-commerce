{% extends 'base.html.twig' %}

{% block title %}Réinitialisation {% endblock %}
{% block importmap %}
    {{ importmap(['app', 'request-password']) }}
{% endblock %}
{% block body %}
    {% for flash_error in app.flashes('reset_password_error') %}
        <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
    {% endfor %}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8 py-5">
                <div class=" reset-card" id="reset-password-card">
                    <div class=" p-4">
                        <!-- Step  Email Verification -->
                        <div class="bg-white" >
                            <h1 class="h4 fw-semibold card-title text-sm-center text-capitalize text-primary">Email Verification</h1>
                        </div>
                        <hr class="text-primary" />
                        <div class="d-grid gap-2 mb-3">
                            <ul class="list-group">
                                <li id="dialog-reset-password" class="list-group-item small text-warning fw-bolder rounded-3">&nbsp;</li>
                            </ul>
                        </div>
                        <div class="step-content" id="step-verification">
                            {{ form_start(form,{ attr : { id:'resetPasswordForm',novalidate: 'novalidate'}}) }}
                            <div class="form-floating mb-3">
                                {{ form_widget(form.email) }}
                                {{ form_label(form.email)}}
                                <div class="text-danger small">
                                    {{ form_errors(form.email)}}
                                </div>
                            </div>
                            <div class="d-grid">
                                {{ form_widget(form.submit) }}
                                {{ form_label(form.submit) }}
                            </div>
                            {{ form_end(form) }}
                            <hr class="text-warning border-3" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
