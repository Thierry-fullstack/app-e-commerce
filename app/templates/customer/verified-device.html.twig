{% extends 'base.html.twig' %}

{% block title %}Verification de connexion{% endblock %}

{% block body %}
    {% if exception is defined and exception is not null %}
        {{ exception }}
    {%  endif %}
    <div class="d-flex align-items-center justify-content-center">
        <div class="w-100 my-5" style="max-width: 480px;">
            <div class="card-body">
                <div class="text-center">
                    <h1 class="card-title text-center text-capitalize text-primary fw-semibold">Code</h1>
                    <div class="d-grid gap-2 mb-3">
                        <ul class="list-group">
                            <li id="dialogLogin" class="list-group-item text-warning fw-bolder">Saisir le code reçu</li>
                        </ul>
                    </div>
                </div>
                <div class="mt-4">
                    {{ form_start(form) }}
                    <div class="form-floating mb-3 mx-1">
                        {{ form_widget(form.number) }}
                        {{ form_label(form.number)}}
                        <div class="fs-6">
                            {{ form_errors(form.number)}}
                        </div>
                    </div>
                    {{ form_end(form) }}
                </div>
                <hr class="text-warning border-3" />
            </div>
        </div>
    </div>
{% endblock %}
