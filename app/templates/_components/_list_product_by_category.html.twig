<div class="card mb-1">
    <div class="card-body">
        <div class="row cart-item mb-1">
            <div class="col-md-3">
                {% set photo = random([product.images[0].name,product.images[1].name,product.images[2].name]) %}
                <img src="{{ asset('/assets/uploads/product/mini/300x300-') ~ photo  }}" alt="{{ product.name }}" class="img-fluid rounded">
            </div>
            <div class="col-md-5">
                <h5 class="card-title">{{ product.name }}</h5>
                <p class="text-muted">Categorie: {{ product.categorie.name }}</p>
                <p class="text-muted">Caractéristique: {{ product.description }}</p>
            </div>
            <div class="col-md-3 text-end">
                <p class="fw-bold text-primary">Prix : {{ product.price * 0.01 | number_format(2,)  }} &#8364;</p>
                <p class="fw-bolder small">stock disponible : {{ product.stock }}</p>
                <a href="{{ path('app_product_show_article',{slug:product.slug}) }}" type="button" class="btn btn-sm btn-secondary">Voir le produit</a>
            </div>
        </div>
        <hr class="text-warning border-3">
    </div>
</div>
