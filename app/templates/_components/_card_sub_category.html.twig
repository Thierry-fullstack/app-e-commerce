
{% if category is defined %}
    <article class="my-2" style="width: 18rem;">
        <h6 class="card-title text-primary fw-semibold mb-2 text-capitalize">{{ category.slug }}</h6>
        <img src="{{ asset('assets/uploads/category/') ~ category.name }}" alt="{{ category.slug }}" class="img-fluid pe-4 h-50 w-50" alt="{{ category.alt }}">
        <div class="my-2">
            <a href="{# path('app_main_list_categories',{id:type.id}) #}" class="btn btn-sm btn-outline-primary">Voir les articles</a>
        </div>
    </article>
{% endif %}
