
    <tr class="table-default">
        <th scope="row">
            <img
                src="{{ asset('/assets/uploads/type/mini/300x300-') ~ type.url }}"
                class="img-thumbnail float-start list_photos_type"
                alt="{{ type.slug }}"
            />
        </th>
        <td class="d-none d-sm-table-cell">{{ type.id }}</td>
        <td>{{ type.slug }}</td>
        <td class="d-none d-sm-table-cell">{% if type.isParent == 1 %}
                <span class="text-success">Vrai</span>
              {% else %}
                  <span class="text-danger">Faux</span>
            {% endif %}
        </td>
        <td><a href="#" type="button" class="btn btn-sm btn-outline-secondary">Supprimer</a></td>
    </tr>




