
{% if type is defined and type is not empty %}
    <div class="card mb-1" style="width: 12rem;">
        <h6 class="card-header text-capitalize">{{ type.name }}</h6>
        <img src="{{ asset('assets/uploads/type/') ~ type.url }}"  class="img-fluid rounded mx-auto d-block h-50 w-50" alt="{{ type.alt }}">
        <div class="card-body">
        </div>
        <div class="card-footer text-muted">
            <a href="{# path('app_category_list_products',{slug:category.slug}) #}" class="btn btn-sm btn-outline-info text-capitalize mx-auto d-block">Voir les produits</a>
        </div>
    </div>
{% endif %}
