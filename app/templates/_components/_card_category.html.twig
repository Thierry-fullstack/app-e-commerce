
{% if type is defined and type is not empty %}
    <article class="my-2" style="width: 18rem;">
        <h5 class="card-title text-primary fw-bold fst-italic mb-2 text-capitalize">{{ type.name }}</h5>
        <img src="{{ asset('assets/uploads/type/') ~ type.url }}"  class="img-fluid pe-4 h-50 w-50" alt="{{ type.alt }}">
        <div class="my-2">
            <a href="{{ path('app_main_list_types',{ name :type.name } ) }}" class="btn btn-sm btn-outline-primary text-capitalize">Voir les produits</a>
        </div>
    </article>
{% endif %}
