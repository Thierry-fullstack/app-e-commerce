{% extends 'base.html.twig' %}

{% block title %}Nouvelle marque{% endblock %}
{% block importmap %}
    {{ importmap(['app','ajax-mark']) }}
{% endblock %}
{% block body %}
    <section class="bg-light-alt">
        <div class="container">
            <div class="section-title">
                <h3 class="text-primary-emphasis ">Nouvelle marque</h3>
                <p class="text-primary">Indication : <span class="text-capitalize text-warning-emphasis">Télécharger le logo de la marque</span></p>
            </div>
            <div class="row">
                <div class="col-md-8 mx-auto">
                    {{ form_start(form,{attr:{id:'newMarkForm',novalidate:'novalidate'}}) }}
                    <div class="form-floating mb-3">
                        {{ form_widget(form.name) }}
                        {{ form_label(form.name) }}
                        <div class="text-danger small">
                        {{ form_errors(form.name) }}
                        </div>
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
        <div class="container  mt-5">
            <div class="row">
                <div class="col-md-8 mx-auto">
                {% if marks is defined and marks is not null %}
                <table class="table table-hover" id="marks_list">
                    <thead>
                    <tr class="table-primary">
                        <th scope="col">Photo</th>
                        <th scope="col">id</th>
                        <th scope="col">name</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for mark in marks %}
                        {% include '_components/_list_marks.html.twig' %}
                    {% endfor %}
                    </tbody>
                </table>
                    <hr class="my-3 text-primary" />
                    <!-- Pagination-->
                    <nav aria-label="Pagination" class="d-flex justify-content-center">
                        {{ knp_pagination_render(marks) }}
                    </nav>
                {% endif %}
                </div>
            </div>
        </div>
    </section>
{% endblock %}
