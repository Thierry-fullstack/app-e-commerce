{% extends 'base.html.twig' %}

{% block title %}Nouvelle marque{% endblock %}
{% block importmap %}
    {{ importmap(['app','ajax-mark']) }}
{% endblock %}
{% block body %}
    <section>
        <div class="container">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('app_admin_index') }}"><span class="badge bg-primary">Administration</span></a></li>
                    <li class="breadcrumb-item"><a>Marques</a></li>
                    <li class="breadcrumb-item"><a>Nouvelle</a></li>
                </ol>
            </nav>
            <div class="section-title">
                <h3 class="text-primary-emphasis">Nouvelle marque</h3>
                <p class="text-primary">Indication : <span class="text-capitalize text-warning-emphasis">Télécharger le logo de la marque</span></p>
            </div>
            <div class="row">
                <div class="col-md-8 mx-auto">
                    {{ form_start(form,{attr:{id:'newMarkForm',novalidate:'novalidate'}}) }}
                    <div class="form-floating mb-3">
                        {{ form_widget(form.name) }}
                        {{ form_label(form.name) }}
                        <div class="text-danger small">
                        {{ form_errors(form.name) }}
                        </div>
                    </div>
                    <div class="d-flex justify-content-end">
                        {{ form_row(form.submit) }}
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
        <div class="container mt-3">
            <div class="row">
                <div class="col-md-8 mx-auto">
                {% if marks is not empty %}
                    <fieldset class="text-primary-emphasis" ><legend class="d-flex justify-content-center">Liste des marques</legend></fieldset>
                <table class="table table-hover table-bordered" id="marks_list">
                    <thead>
                    <tr class="table-active">
                        <th class="text-warning" scope="col">Photo</th>
                        <th class="text-warning d-none d-sm-table-cell" scope="col">N°</th>
                        <th class="text-warning" scope="col">Nom</th>
                        <th class="text-warning" scope="col">Action</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for mark in marks %}
                         {% include '_components/_list_marks.html.twig' with { marks : marks } %}
                    {% endfor %}
                    </tbody>
                </table>
                    <!-- Pagination-->
                    <nav aria-label="Pagination" class="d-flex justify-content-center">
                        {{ knp_pagination_render(marks) }}
                    </nav>
                    <hr class="my-3 text-primary" />
                {% endif %}
                </div>
            </div>
        </div>
    </section>
{% endblock %}
